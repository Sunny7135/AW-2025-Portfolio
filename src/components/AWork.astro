---
const { caption, cssClass, index, site, src, total } = Astro.props

// A random string with the syntax '[a-z][0-9]{3}-index-total'
const key = Math.random().toString(36).slice(2, 6) + '-' + index + '/' + total
---

<a-work class={cssClass}>
  <div class="a__inner">
    <a href={site} target={site && site.startsWith('http') ? '_blank' : '_self'}>
      <div class="a__overlay js-overlay">
        <div class="a__overlay__content">
          <span class="a__overlay__text">Project In Progress</span>
          <br />
          <span class="a__overlay__sub">Stay Tuned!</span>
        </div>
      </div>

      <div class="media-container">
        {String(src).includes('.mp4') ? (
          <video
            src={src}
            data-src={src}
            class="a__video js-video"
            autoplay
            loop
            muted
            playsinline
            width="1082"
            height="636"
          >
          </video>
        ) : (
          <div class="black-hole-wrapper">
            <img
              src={src}
              alt={caption}
              class="a__video a__image js-image"
              width="1082"
              height="636"
              loading="lazy"
            />
            <canvas class="black-hole-motion-canvas js-motion-canvas"></canvas>
          </div>
        )}
      </div>

      <div class="a__caption">
        <div class="a__caption__text">
          {caption}
        </div><!-- .a__caption__text -->

        <div class="a__caption__key">
          #{key}
        </div><!-- .a__caption__key -->
      </div><!-- .a__caption -->
    </a>
  </div><!-- .a__inner -->
</a-work>

<script>
  class AWork extends HTMLElement {
    static observedAttributes = ['progress']

    link: HTMLAnchorElement
    video: HTMLVideoElement | null
    canvas: HTMLCanvasElement | null
    ctx: CanvasRenderingContext2D | null
    overlay: HTMLElement

    isPlaying: boolean
    animId: number | null
    particles: Array<{ x: number; y: number; r: number; angle: number; speed: number; distance: number; color: string }>

    /**
     * Init
     */
    connectedCallback() {
      // Elements
      this.video = this.querySelector('.js-video')
      this.overlay = this.querySelector('.js-overlay')
      this.link = this.querySelector('a')
      this.canvas = this.querySelector('.js-motion-canvas')

      // Properties
      this.isPlaying = false
      this.particles = []
      this.animId = null

      if (this.canvas) {
        this.initCanvasMotion()
      }

      // Events
      this.link.addEventListener('click', this.onClick.bind(this))
    }

    initCanvasMotion() {
      if (!this.canvas) return
      this.ctx = this.canvas.getContext('2d')
      
      const width = (this.canvas.width = 1082)
      const height = (this.canvas.height = 636)
      const centerX = width * 0.62
      const centerY = height * 0.48

      // Initialize cosmic accretion particles
      const colors = ['#38bdf8', '#818cf8', '#c084fc', '#f472b6', '#38bdf8']
      for (let i = 0; i < 90; i++) {
        this.particles.push({
          x: centerX,
          y: centerY,
          r: Math.random() * 2.5 + 0.5,
          angle: Math.random() * Math.PI * 2,
          speed: Math.random() * 0.02 + 0.008,
          distance: Math.random() * 260 + 40,
          color: colors[Math.floor(Math.random() * colors.length)]
        })
      }

      let time = 0

      const animate = () => {
        if (!this.ctx || !this.canvas) return
        time += 0.02
        this.ctx.clearRect(0, 0, width, height)

        // 1. Swirling Cosmic Particles into Singularity
        this.particles.forEach((p) => {
          p.angle += p.speed
          p.distance -= 0.15
          if (p.distance < 20) {
            p.distance = Math.random() * 240 + 60
          }

          const px = centerX + Math.cos(p.angle) * p.distance * 1.3
          const py = centerY + Math.sin(p.angle) * (p.distance * 0.65)

          this.ctx.save()
          this.ctx.beginPath()
          this.ctx.arc(px, py, p.r, 0, Math.PI * 2)
          this.ctx.fillStyle = p.color
          this.ctx.shadowBlur = 8
          this.ctx.shadowColor = p.color
          this.ctx.globalAlpha = 0.85
          this.ctx.fill()
          this.ctx.restore()
        })

        // 2. Pulsing Photon Ring Energy Lens
        this.ctx.save()
        this.ctx.beginPath()
        this.ctx.ellipse(centerX, centerY, 130 + Math.sin(time * 2) * 5, 65 + Math.cos(time * 2) * 3, -0.3, 0, Math.PI * 2)
        this.ctx.strokeStyle = 'rgba(56, 189, 248, 0.45)'
        this.ctx.lineWidth = 2.5
        this.ctx.shadowBlur = 15
        this.ctx.shadowColor = '#38bdf8'
        this.ctx.stroke()
        this.ctx.restore()

        // 3. Futuristic Scanning Telemetry Line
        const scanY = (Math.sin(time * 0.8) * 0.5 + 0.5) * height
        this.ctx.save()
        this.ctx.beginPath()
        this.ctx.moveTo(0, scanY)
        this.ctx.lineTo(width, scanY)
        this.ctx.strokeStyle = 'rgba(129, 140, 248, 0.15)'
        this.ctx.lineWidth = 1.5
        this.ctx.stroke()
        this.ctx.restore()

        this.animId = requestAnimationFrame(animate)
      }

      animate()
    }

    /**
     * Attribute changed
     */
    attributeChangedCallback(name, oldValue, newValue) {
      if (name === 'progress') {
        this.style.setProperty('--progress', newValue)

        if (newValue === '1' || newValue === '-1') {
          if (this.isPlaying) {
            this.outView()
          }
        } else {
          if (!this.isPlaying) {
            this.inView()
          }
        }
      }
    }

    /**
     * Gets in view
     */
    inView() {
      if (this.video) this.video.play().catch(() => {})
      this.isPlaying = true
      this.classList.add('is-inview')
    }

    /**
     * Gets out view
     */
    outView() {
      if (this.video) this.video.pause()
      this.isPlaying = false
      this.classList.remove('is-inview')
    }

    /**
     * On click
     */
    onClick(event: MouseEvent) {
      if (this.link.getAttribute('href') === '#') {
        event.preventDefault()
        
        // Show overlay with animation
        this.overlay.classList.add('is-active')
        setTimeout(() => {
          this.overlay.classList.remove('is-active')
        }, 2000)

        return false
      }
    }
  }

  customElements.define('a-work', AWork)
</script>

<style lang="scss">
  a-work {
    position: relative;
    top: 0;
    left: 0;

    display: block;
    margin: 0;
    padding: 0.5rem 0.5rem 0;

    background: color(secondary);
    content-visibility: hidden;

    transform-style: preserve-3d;

    will-change: transform;

    @include mq(phone) {
      padding: 0.25rem;
    }

    a {
      display: block;

      text-decoration: none;
    }

    .a__inner {
      display: block;
      margin: 0;
      padding: 0;
    }

    .media-container {
      position: relative;
      overflow: hidden;
    }

    .black-hole-wrapper {
      position: relative;
      width: 100%;
      height: 100%;
    }

    .black-hole-motion-canvas {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 2;
    }

    .a__video {
      display: block;

      width: auto;
      max-width: 65vw;
      height: auto;
      max-height: 65vh;

      @include mq(phone) {
        max-width: 85vw;
        max-height: 85vh;
      }
    }

    .a__caption {
      @include flex(row, center, space-between);

      padding: 0.5rem 0.5rem;

      color: color(primary);
      font: 700 11px / 1 font-family(fraktion);
      letter-spacing: 0.15em;
      text-align: right;
      text-transform: uppercase;

      @include mq(phone) {
        display: none;
      }
    }

    &.is-inview {
      content-visibility: visible;
    }

    .a__overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(color(secondary), 0.95);
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      z-index: 10;
      opacity: 0;
      visibility: hidden;
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      backdrop-filter: blur(10px);
      pointer-events: none;

      &.is-active {
        opacity: 1;
        visibility: visible;
      }

      &__content {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 2rem;
        border: 1.5px solid color(primary);
      }

      &__text {
        font: 700 1.5rem / 1 font-family(bigger);
        color: color(primary);
        text-transform: uppercase;
        letter-spacing: 0.1em;

        @include mq(phone) {
          font-size: 1.1rem;
        }
      }

      &__sub {
        font: 400 0.8rem / 1 font-family(fraktion);
        color: color(primary);
        opacity: 0.7;
        text-transform: uppercase;
        letter-spacing: 0.25em;

        @include mq(phone) {
          font-size: 0.6rem;
        }
      }
    }
  }
</style>
